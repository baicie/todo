# Production TLS termination for the API.
#
# Set APP_DOMAIN to the public hostname. Caddy obtains and renews certificates
# automatically. For a local demo, APP_DOMAIN=localhost uses Caddy's local CA.
#
# Access logging is intentionally disabled: request query strings can contain
# one-time bootstrap continuations. The API emits structured, redacted logs to
# stdout instead.

{$APP_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy api:8787

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
