# 开发默认值。生产部署请按 docs/runbooks/production.md 注入真实密钥。
APP_ENV=development
DATABASE_URL=postgres://todo:todo@localhost:5432/todo
BIND_ADDR=127.0.0.1:8787
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
AUTH_DEV_CODE=246810
AUTH_CODE_TTL_SECONDS=600
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_REQUESTS_PER_WINDOW=5
AUTH_CODE_WINDOW_SECONDS=900
AUTH_CODE_GLOBAL_REQUESTS_PER_WINDOW=300
AUTH_CODE_MAX_ATTEMPTS=5
COOKIE_SECURE=false
RUST_LOG=todo_api=debug,tower_http=info

# Web app (optional cloud sync). The app works fully local without this.
VITE_API_URL=http://127.0.0.1:8787

# Production SMTP (required when APP_ENV=production)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls          # starttls | implicit
# AUTH_USERNAME=...
# AUTH_PASSWORD=...
# MAIL_FROM=Shishi <no-reply@example.com>

# Web Push (disabled by default; all VAPID values are required when enabled)
WEB_PUSH_ENABLED=false
# VAPID_PUBLIC_KEY=<URL-safe base64 uncompressed P-256 public key>
# VAPID_PRIVATE_KEY=<URL-safe base64 raw P-256 private key>
# VAPID_SUBJECT=mailto:ops@example.com
# PUSH_WORKER_INTERVAL_SECONDS=30

# Protected ops CLI (required for ops ... --apply)
# OPS_ADMIN_TOKEN=<at least 32 characters>
# OPS_CONFIRM=APPLY
# OPS_BATCH_SIZE=5000
# AUTH_CODE_RETENTION_DAYS=1
# SESSION_RETENTION_DAYS=7
# OP_RECEIPT_RETENTION_DAYS=90
# CHANGE_LOG_RETENTION_DAYS=90
# ACCOUNT_PURGE_GRACE_DAYS=7
# RATE_LIMIT_RETENTION_HOURS=24

# Caddy / backups
# APP_DOMAIN=api.example.com
# BACKUP_RETENTION_DAYS=14
# POSTGRES_DB=todo
# POSTGRES_USER=todo
# POSTGRES_PASSWORD=change-me
