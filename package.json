{
  "name": "orbit",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter orbit-backend --filter orbit-web dev",
    "dev:web": "pnpm --filter orbit-web dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter orbit-web build",
    "build:desktop": "pnpm --filter orbit-desktop build",
    "build:browser-ext": "pnpm --filter orbit-browser-ext build",
    "build:backend": "pnpm --filter orbit-backend build",
    "build:miniprogram": "pnpm --filter orbit-miniprogram build:weapp",
    "build:mobile": "pnpm --filter orbit-mobile typecheck",
    "build:vscode-ext": "pnpm --filter orbit-vscode-ext compile",
    "lint": "pnpm -r lint",
    "fix": "eslint --fix",
    "format": "prettier --write --cache .",
    "format:check": "prettier --check --cache .",
    "check": "pnpm -C packages/todo-model exec tsc --noEmit",
    "test-unit": "echo \"No unit tests configured\"",
    "test-e2e": "echo \"No e2e tests configured\"",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm check",
    "commit-msg": "node -e \"import('@baicie/scripts').then(m => m.verifyCommit())\""
  },
  "lint-staged": {
    "*.{js,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@baicie/scripts": "^0.1.2",
    "@eslint/compat": "^2.0.5",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lint-staged": "^16.4.0",
    "lodash-es": "^4.18.1",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "rolldown-plugin-dts": "^0.24.1",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.4.1"
  }
}
