{
  "name": "orbit-vscode-ext",
  "displayName": "Orbit",
  "description": "A cross-platform Orbit todo extension in monorepo",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "orbitTasks",
          "name": "Orbit Tasks",
          "icon": "$(checklist)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "orbitTasks",
        "contents": "No tasks yet. Run 'Orbit: Add Task' to create one."
      }
    ],
    "commands": [
      {
        "command": "orbit-vscode-ext.helloWorld",
        "title": "Orbit: Overview"
      },
      {
        "command": "orbit-vscode-ext.addTask",
        "title": "Orbit: Add Task"
      },
      {
        "command": "orbit-vscode-ext.refreshTasks",
        "title": "Orbit: Refresh"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -b",
    "watch": "tsc -b -w",
    "package": "vsce package",
    "lint": "eslint . --fix"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@types/node": "25.x",
    "typescript": "^6.0.3",
    "@baicie/orbit-tsconfig": "workspace:*"
  },
  "dependencies": {
    "@baicie/orbit": "workspace:*",
    "@baicie/orbit-hooks": "workspace:*",
    "@baicie/orbit-utils": "workspace:*"
  }
}
