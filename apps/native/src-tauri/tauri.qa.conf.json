{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shishi QA RC2D",
  "version": "1.0.0-rc2d",
  "identifier": "app.shishi.todo.qa",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shishi QA RC2D",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Shishi QA build - not a production release",
    "longDescription": "Isolated QA build for RC2-D native reliability validation.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
