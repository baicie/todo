{
  "extends": "@baicie/orbit-tsconfig/react.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["chrome"]
  },
  "include": ["src"],
  "exclude": ["node_modules"],
  "references": [
    { "path": "../../packages/todo-model" },
    { "path": "../../packages/utils" },
    { "path": "../../packages/hooks" },
    { "path": "../../packages/ui" }
  ]
}
