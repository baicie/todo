{
  "name": "@baicie/orbit-utils",
  "version": "0.0.1",
  "description": "Shared utility functions for Orbit",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "scripts": {
    "build": "rolldown -c",
    "dev": "rolldown -w -c",
    "lint": "eslint .",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@baicie/orbit": "workspace:*"
  },
  "devDependencies": {
    "@baicie/orbit-tsconfig": "workspace:*",
    "rolldown": "1.0.0-rc.18",
    "typescript": "^6.0.3"
  }
}
